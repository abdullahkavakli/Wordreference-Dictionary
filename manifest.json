{
   "author": "WordReference Dictionary Extension",
   "manifest_version": 3,
   "minimum_chrome_version": "114",
   "default_locale": "en",
   "name": "__MSG_extName__",
   "short_name": "__MSG_extShortName__",
   "description": "__MSG_extDescription__",
   "version": "2.3.4",

   "action": {
      "default_icon": {
         "16":  "images/icon-16.png",
         "32":  "images/icon-32.png",
         "48":  "images/icon-48.png",
         "128": "images/icon-128.png"
      },
      "default_title": "__MSG_actionTitle__"
   },

   "icons": {
      "16":  "images/icon-16.png",
      "32":  "images/icon-32.png",
      "48":  "images/icon-48.png",
      "128": "images/icon-128.png"
   },

   "permissions": [ "activeTab", "contextMenus", "scripting", "storage", "tts", "declarativeNetRequestWithHostAccess" ],
   "host_permissions": [ "https://www.wordreference.com/*" ],
   "optional_host_permissions": [ "<all_urls>" ],

   "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'self'; worker-src 'self'"
   },

   "web_accessible_resources": [
      {
         "resources": [ "pdf-viewer.html", "vendor/pdfjs/*" ],
         "matches": [ "<all_urls>" ]
      }
   ],

   "background": {
      "service_worker": "scripts/background.js"
   },

   "content_scripts": [
      {
         "matches": [ "https://*/*" ],
         "js": [ "scripts/favorites.js", "scripts/content.js" ],
         "run_at": "document_end",
         "all_frames": false
      }
   ],

   "options_page": "info.html",

   "commands": {
      "_execute_action": {
         "suggested_key": {
            "default":  "Alt+Z",
            "windows":  "Alt+Z",
            "mac":      "Alt+Z",
            "chromeos": "Alt+Z",
            "linux":    "Alt+Z"
         }
      },
      "show-translation-popup": {
         "suggested_key": {
            "default":  "Alt+X",
            "windows":  "Alt+X",
            "mac":      "Alt+X",
            "chromeos": "Alt+X",
            "linux":    "Alt+X"
         },
         "description": "__MSG_commandShowTranslationDescription__"
      },
      "quick-lookup-selection": {
         "suggested_key": {
            "default":  "Alt+Q",
            "windows":  "Alt+Q",
            "mac":      "Alt+Q",
            "chromeos": "Alt+Q",
            "linux":    "Alt+Q"
         },
         "description": "__MSG_commandQuickLookupDescription__"
      }
   }
}
